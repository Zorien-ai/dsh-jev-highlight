{
  "name": "@local/dsh-jev-highlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jev-powered importance highlighting for DSH agent streaming output: judges semantic content units with StartLux/Jev noul questions and renders confidence-weighted CSS Custom Highlights without touching the agent DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q93304989-bit/dsh-jev-highlight.git"
  },
  "homepage": "https://github.com/q93304989-bit/dsh-jev-highlight",
  "bugs": {
    "url": "https://github.com/q93304989-bit/dsh-jev-highlight/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "jev",
    "startlux",
    "highlight",
    "css-custom-highlight"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "PLUGIN-README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "probe:jev": "node scripts/jev-probe.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
